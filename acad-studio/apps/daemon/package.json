{
  "name": "@acad/daemon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "dev": "ACAD_SQLJS_WASM=node_modules/sql.js/dist/sql-wasm.wasm MEP_SQLJS_WASM=node_modules/sql.js/dist/sql-wasm.wasm tsx watch src/server.ts",
    "start": "ACAD_SQLJS_WASM=node_modules/sql.js/dist/sql-wasm.wasm MEP_SQLJS_WASM=node_modules/sql.js/dist/sql-wasm.wasm tsx src/server.ts",
    "test:raw": "tsx scripts/test-objectarx-raw.mjs",
    "test:control": "tsx scripts/test-acad-control.mjs",
    "test:contract": "tsx scripts/test-bridge-contract.mjs",
    "test:headless": "tsx scripts/test-headless-layer.mjs",
    "test:live": "tsx scripts/test-objectarx-live.mjs",
    "test:preview": "tsx scripts/test-preview-apply.mjs",
    "test:live-preview": "tsx scripts/test-live-preview.mjs",
    "test:ui-preview": "tsx scripts/test-ui-preview.mjs",
    "test:stability": "tsx scripts/test-acad-stability.mjs",
    "test:identity": "tsx scripts/test-product-identity.mjs",
    "test:draw-t1": "tsx scripts/test-draw-t1.mjs",
    "test:lisp-library": "tsx scripts/test-lisp-library.mjs",
    "test:lisp-proposal": "tsx scripts/test-lisp-proposal.mjs",
    "test:standards-profile": "tsx scripts/test-standards-profile.mjs",
    "test:standards-engine": "tsx scripts/test-standards-engine.mjs",
    "test:standards-router": "tsx scripts/test-drawing-standards.mjs",
    "test:standards": "npm run test:standards-profile && npm run test:standards-engine && npm run test:standards-router",
    "test:cad-selection": "node --import tsx scripts/test-cad-selection.mjs",
    "test:block-library": "tsx scripts/test-block-library.mjs && tsx scripts/test-block-library-cad.mjs && tsx scripts/test-block-library-router.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
