{
  "name": "@acad/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "test:cadweb-viewer": "node scripts/test-cadweb-viewer.mjs && pnpm --filter @acad/cadweb exec tsx --test ../web/scripts/test-cadweb-transform.test.ts ../web/scripts/test-cadweb-incremental.test.ts ../web/scripts/test-cadweb-recovery.test.ts",
    "test:contract": "node scripts/test-contract.mjs && pnpm --filter @acad/cadweb exec tsx --test ../web/scripts/test-preconstruction.test.ts ../web/scripts/test-acad-events.test.ts ../web/scripts/test-chat-messages.test.ts",
    "check:css": "node scripts/check-css-collisions.mjs",
    "check:boundaries": "node scripts/check-import-boundaries.mjs",
    "check:guards": "node scripts/extract-guard-codes.mjs",
    "check:types": "tsc --noEmit -p tsconfig.json",
    "test:routes": "node scripts/test-route-serving.mjs",
    "verify": "pnpm check:css && pnpm check:boundaries && pnpm check:guards && pnpm check:types && pnpm test:contract && pnpm build && pnpm test:routes",
    "start": "next start -p 3000"
  },
  "dependencies": {
    "@acad/cadweb": "workspace:*",
    "next": "^16.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "typescript": "^5.9.3"
  }
}
