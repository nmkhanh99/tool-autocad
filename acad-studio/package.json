{
  "name": "acad-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Acad Studio — shell UI/daemon for AutoCAD Toolkit (Offline + ACAD Control + ObjectARX)",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "verify": "pnpm typecheck:daemon && pnpm --filter @acad/daemon test:cad-selection && pnpm --filter @acad/daemon test:standards && pnpm --filter @acad/web verify",
    "typecheck:daemon": "pnpm --filter @acad/daemon exec tsc --noEmit -p tsconfig.json",
    "daemon": "pnpm --filter @acad/daemon dev",
    "web": "pnpm --filter @acad/web dev",
    "desktop": "pnpm --filter @acad/desktop dev",
    "mcp": "pnpm --filter @acad/mcp start",
    "test:mcp": "pnpm --filter @acad/mcp test",
    "test:mcp:live": "pnpm --filter @acad/mcp test:live",
    "tools-dev": "node scripts/tools-dev.mjs",
    "package": "node scripts/package.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "electron"
    ]
  }
}
